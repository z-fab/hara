    given-names: Fabricio
license: MIT
version: "0.1.0"
date-released: "2026-05-03"
repository-code: "https://github.com/z-fab/hara"
keywords:
  - retrieval-augmented-generation
  - multi-agent
  - llm
  - hybrid-retrieval
  - question-answering
  - langgraph
  - text-to-sql
